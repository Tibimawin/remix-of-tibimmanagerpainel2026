# ============================================================
# Exemplo de variáveis de ambiente (Vite)
#
# Copie este arquivo para `.env` e preencha os valores:
#   cp .env.example .env
#
# Regras:
# - Somente VITE_* são expostas ao frontend (Vite injeta em build
#   time; mudar uma variável exige rebuild, não só reiniciar).
# - Firebase e proxy já têm valores padrão embutidos em
#   src/config/firebase.ts e src/config/proxyConfig.ts, então o app
#   roda sem .env — mas noutro ambiente (AI Studio, Vercel, local
#   com outro Firebase) preencha.
# - Nunca coloque secretas (Supabase service_role, chaves de API)
#   no frontend: use apenas as chaves públicas/publishable.
# ============================================================

# ---------- Firebase (opcional — há fallback embutido no código) ----------
# Chave pública do projeto Firebase (Auth, Firestore, Storage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------- Proxy Baserow (opcional — há fallback para o deploy Vercel) ----------
# Host das rotas serverless /api/* (baserow-proxy, stream-proxy, m3u-proxy,
# asaas-proxy). Necessário quando o painel roda fora da Vercel
# (ex.: Lovable, AI Studio, local): aponte para o deploy Vercel existente.
VITE_VERCEL_PROXY_BASE=

# ---------- Backend Supabase/Lovable Cloud (obrigatório em telas que usam o backend) ----------
# Sem estas variáveis, chat, funções e storage do Supabase ficam quebrados.
# Copie do .env do projeto Lovable (aba de arquivos).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---------- Debug (opcional) ----------
# true exibe erros estendidos na tela de erro; false oculta.
VITE_DEBUG_ERRORS=
